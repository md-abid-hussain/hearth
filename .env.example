# Copy to .env in this folder (presage-dev-to/.env). Wisp reads it at startup.

# Presage SmartSpectra (camera vitals + Presage Insights)
SMARTSPECTRA_API_KEY=

# AssemblyAI (push-to-talk speech-to-text and Wisp's voice)
ASSEMBLYAI_API_KEY=

# Conversation model: openai or anthropic
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# none | low | medium | high | xhigh | max  (lower = faster spoken replies)
OPENAI_MODEL_REASONING=low

# Needed only when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5

# Optional: Gmail, Google Calendar and Google Drive (read-only) through Composio, plus Composio's
# app search and Instant tools. Use a Platform project key (ak_...), not the For You key (ck_...):
# dashboard.composio.dev > Platform > your project > Settings > API Keys > Create API Key, with
#   Session management: Read and write   Session tool execution: Write only
#   Connected accounts: Read and write   everything else: No access
# Then sign in to each Google app from Wisp's Connectors page.
# Notion, Linear and the other presets need nothing here: you sign in from the Connectors page.
COMPOSIO_API_KEY=

# Optional overrides
# WISP_TTS_VOICE=aai-kyla
# WISP_MCP_CONFIG=C:\path\to\mcp.json

# Copy to .env in this folder (presage-dev-to/.env). Wisp reads it at startup.

# Presage SmartSpectra (camera vitals + Presage Insights)
SMARTSPECTRA_API_KEY=

# AssemblyAI (push-to-talk speech-to-text and Wisp's voice)
ASSEMBLYAI_API_KEY=

# Conversation model: openai or anthropic
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# none | low | medium | high | xhigh | max  (lower = faster spoken replies)
OPENAI_MODEL_REASONING=low

# Needed only when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5

# Optional: Google's Gmail, Calendar and Drive MCP servers need your own OAuth client
# (Google Auth Platform > Clients > Desktop app, with "Use this client for an AI-powered agent").
# Notion and Linear need nothing here: you just sign in from the Connectors page.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Optional overrides
# WISP_TTS_VOICE=aai-kyla
# WISP_MCP_CONFIG=C:\path\to\mcp.json

# Copy to .env in this folder (presage-dev-to/.env). Wisp reads it at startup.

# Presage SmartSpectra (camera vitals + Presage Insights)
SMARTSPECTRA_API_KEY=

# AssemblyAI (push-to-talk speech-to-text and Wisp's voice)
ASSEMBLYAI_API_KEY=

# Conversation model: openai or anthropic
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# none | low | medium | high | xhigh | max  (lower = faster spoken replies)
OPENAI_MODEL_REASONING=low

# Needed only when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5

# Composio: sign in to Gmail, Calendar, GitHub and more from the Connectors page.
# Free key at https://platform.composio.dev. Wisp only ever gets read-only tools.
COMPOSIO_API_KEY=

# Optional overrides
# WISP_TTS_VOICE=aai-kyla
# WISP_MCP_CONFIG=C:\path\to\mcp.json

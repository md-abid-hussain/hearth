{
  "name": "wisp",
  "version": "0.1.0",
  "description": "Wisp: a push-to-talk desk companion that responds to live SmartSpectra wellness signals.",
  "main": "./out/main/index.js",
  "author": "abid1",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.105",
    "@ai-sdk/openai": "^4.0.118",
    "@composio/core": "^0.29.0",
    "@composio/vercel": "^0.13.0",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@mantine/charts": "^9.8.1",
    "@mantine/core": "^9.8.1",
    "@mantine/hooks": "^9.8.1",
    "@mantine/modals": "^9.8.1",
    "@mantine/notifications": "^9.8.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@smartspectra/node-sdk": "^3.5.0",
    "@tabler/icons-react": "^3.52.0",
    "ai": "^7.0.173",
    "assemblyai": "4.42.0",
    "dotenv": "^18.0.10",
    "protobufjs": "^8.8.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "uiohook-napi": "^1.5.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "postcss": "^8.5.33",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  },
  "allowScripts": {
    "koffi@2.16.4": true,
    "protobufjs@7.6.6": true,
    "electron-winstaller@5.4.0": true,
    "uiohook-napi@1.5.5": true
  }
}
